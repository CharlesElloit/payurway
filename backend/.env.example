# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/paymybills

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change_this_to_a_secure_random_string
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# MTN Mobile Money API
MTN_API_KEY=your_mtn_api_key
MTN_API_URL=https://proxy.momoapi.mtn.com
MTN_SUBSCRIPTION_KEY=your_subscription_key
MTN_ENVIRONMENT=sandbox
MTN_CALLBACK_URL=http://localhost:3000/api/v1/webhooks/mtn

# Airtel Money API
AIRTEL_API_KEY=your_airtel_api_key
AIRTEL_API_URL=https://openapi.airtel.africa
AIRTEL_CLIENT_ID=your_client_id
AIRTEL_CLIENT_SECRET=your_client_secret
AIRTEL_CALLBACK_URL=http://localhost:3000/api/v1/webhooks/airtel

# OTP
OTP_EXPIRY_SECONDS=300
OTP_LENGTH=6
MAX_OTP_ATTEMPTS=3

# QR Code
QR_CODE_EXPIRY_SECONDS=600
QR_CODE_SECRET=change_this_to_a_secure_qr_signing_secret

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
