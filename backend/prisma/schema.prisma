generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(uuid())
  email          String?   @unique
  phone          String    @unique
  passwordHash   String    @map("password_hash")
  firstName      String?   @map("first_name")
  lastName       String?   @map("last_name")
  avatarUrl      String?   @map("avatar_url")
  isVerified     Boolean   @default(false) @map("is_verified")
  isActive       Boolean   @default(true) @map("is_active")
  lastLoginAt    DateTime? @map("last_login_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  accounts          MobileMoneyAccount[]
  sentPayments      Payment[]            @relation("PaymentSender")
  receivedPayments  Payment[]            @relation("PaymentReceiver")
  qrCodes           QRCode[]
  notifications     Notification[]
  refreshTokens     RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  userAgent String?  @map("user_agent")
  ipAddress String?  @map("ip_address")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model MobileMoneyAccount {
  id                String    @id @default(uuid())
  userId            String    @map("user_id")
  phoneNumber       String    @map("phone_number")
  carrier           Carrier
  carrierAccountId  String?   @map("carrier_account_id")
  verificationStatus AccountVerificationStatus @default(pending) @map("verification_status")
  verificationToken String?   @map("verification_token")
  balance           Decimal?  @db.Decimal(12, 2)
  balanceUpdatedAt  DateTime? @map("balance_updated_at")
  isDefault         Boolean   @default(false) @map("is_default")
  isActive          Boolean   @default(true) @map("is_active")
  verifiedAt        DateTime? @map("verified_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@unique([userId, phoneNumber])
  @@index([userId])
  @@index([phoneNumber])
  @@map("mobile_money_accounts")
}

model Payment {
  id                    String        @id @default(uuid())
  reference             String        @unique
  amount                Decimal       @db.Decimal(12, 2)
  currency              String        @default("UGX")
  description           String?
  status                PaymentStatus @default(pending)
  senderPhone           String        @map("sender_phone")
  receiverPhone         String        @map("receiver_phone")
  senderId              String?       @map("sender_id")
  receiverId            String?       @map("receiver_id")
  accountId             String?       @map("account_id")
  carrier               Carrier
  carrierTransactionId  String?       @map("carrier_transaction_id")
  carrierResponse       Json?         @map("carrier_response")
  qrCodeId             String?       @map("qr_code_id")
  externalId            String?       @map("external_id")
  failureReason         String?       @map("failure_reason")
  completedAt           DateTime?     @map("completed_at")
  failedAt              DateTime?     @map("failed_at")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  sender   User?  @relation("PaymentSender", fields: [senderId], references: [id], onDelete: SetNull)
  receiver User?  @relation("PaymentReceiver", fields: [receiverId], references: [id], onDelete: SetNull)
  account  MobileMoneyAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  qrCode   QRCode? @relation(fields: [qrCodeId], references: [id], onDelete: SetNull)

  @@index([senderId])
  @@index([receiverId])
  @@index([status])
  @@index([reference])
  @@index([carrierTransactionId])
  @@map("payments")
}

model QRCode {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  phone         String
  carrier       Carrier
  amount        Decimal? @db.Decimal(12, 2)
  description   String?
  currency      String   @default("UGX")
  signature     String
  isOneTime     Boolean  @default(true) @map("is_one_time")
  isUsed        Boolean  @default(false) @map("is_used")
  isActive      Boolean  @default(true) @map("is_active")
  expiresAt     DateTime @map("expires_at")
  usedAt        DateTime? @map("used_at")
  createdAt     DateTime @default(now()) @map("created_at")

  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([userId])
  @@index([signature])
  @@map("qr_codes")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  type      NotificationType
  title     String
  body      String
  data      Json?
  isRead    Boolean          @default(false) @map("is_read")
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@map("notifications")
}

enum Carrier {
  mtn
  airtel
}

enum AccountVerificationStatus {
  pending
  verified
  failed
}

enum PaymentStatus {
  pending
  processing
  requested
  completed
  failed
  cancelled
  expired
}

enum NotificationType {
  payment_received
  payment_sent
  payment_failed
  payment_requested
  account_verified
  account_link_failed
  security_alert
  system
}
